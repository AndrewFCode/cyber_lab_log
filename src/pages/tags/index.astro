---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, withBase } from '../../lib/collections';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Every tag used across sheets, explainers, notes, example projects and full-picture pages.">
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Tags</h1>
    <p class="mt-3 text-lg text-muted">
      Topics that show up across cheat sheets, explainers, notes, example projects and full-picture pages.
    </p>
  </header>

  {
    tags.length === 0 ? (
      <p class="text-muted">No tags yet.</p>
    ) : (
      <ul class="flex flex-wrap gap-3">
        {tags.map((tag) => (
          <li>
            <a
              href={withBase(`/tags/${tag.slug}`)}
              class="inline-flex items-baseline gap-2 rounded border border-line px-3 py-2 no-underline hover:border-accent"
            >
              <span class="font-mono text-sm text-ink">{tag.label}</span>
              <span class="font-mono text-xs text-faint">{tag.entries.length}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
