---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getProjects, withBase } from '../../lib/collections';

const projects = await getProjects();
---

<BaseLayout
  title="Example Projects"
  description="Book example projects — the code only. Full Picture pages add screenshots of the results."
>
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Example Projects</h1>
    <p class="mt-3 text-lg text-muted">
      Code from the book example projects. For the same exercise with screenshots of what happened,
      use <a href={withBase('/full-picture')}>Full Picture Projects</a>.
    </p>
  </header>

  {
    projects.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <div>
        {projects.map((entry) => (
          <PostCard
            href={withBase(`/example-projects/${entry.id}`)}
            title={entry.data.title}
            description={entry.data.description ?? entry.data.why}
            dateLabel=""
            date={entry.data.pubDate}
            draft={entry.data.draft}
            meta={[
              { active: 'Active', paused: 'Paused', shipped: 'Shipped', archived: 'Archived' }[
                entry.data.status
              ],
              entry.data.origin === 'ai' ? 'AI-generated' : 'Handwritten',
            ]}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
