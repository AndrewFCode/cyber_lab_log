---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getLabs, LAB_SERIES_LABELS, neighbors, readingTime, withBase } from '../../lib/collections';

export const getStaticPaths = (async () => {
  const labs = await getLabs();
  return labs.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      ...neighbors(labs, entry.id, (item) => `/labs/${item.id}`),
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const seriesLabel = LAB_SERIES_LABELS[entry.data.series];
const meta = [seriesLabel, entry.data.lab].filter((item): item is string => Boolean(item));
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  label="Lab"
  collection="labs"
  backHref={withBase('/labs')}
  backLabel="Labs"
  pubDate={entry.data.pubDate}
  draft={entry.data.draft}
  tags={entry.data.tags}
  readingTime={readingTime(entry.body)}
  headings={headings}
  prev={prev}
  next={next}
  meta={meta}
  slug={entry.id}
>
  <Content />
</ContentLayout>
