---
import type { GetStaticPaths } from 'astro';
import { cheatsheetPath, getResourceCheatsheets, withBase } from '../../lib/collections';

// Old /cheatsheets/[slug] URLs land on the matching Resource Cheatsheets tab.
export const getStaticPaths = (async () => {
  const cheatsheets = await getResourceCheatsheets();
  return cheatsheets.map((entry) => ({
    params: { slug: entry.id },
    props: { href: withBase(cheatsheetPath(entry)) },
  }));
}) satisfies GetStaticPaths;

return Astro.redirect(Astro.props.href, 301);
---
