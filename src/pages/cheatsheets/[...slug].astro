---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCheatsheets } from '../../lib/collections';

// Drafts are filtered here as well as in the listing, so a production build
// never emits a page for them — not even at a direct URL.
export const getStaticPaths = (async () => {
  const cheatsheets = await getCheatsheets();
  return cheatsheets.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  label="Cheat sheet"
  backHref="/cheatsheets"
  backLabel="Cheat sheets"
  updated={entry.data.updated}
  draft={entry.data.draft}
  meta={entry.data.category ? [entry.data.category] : []}
>
  <Content />
</ContentLayout>
