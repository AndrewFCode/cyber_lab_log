---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCheatsheets } from '../../lib/collections';

const cheatsheets = await getCheatsheets();

// Already sorted pinned-first then newest-updated. Grouping preserves that
// order, so a category's position reflects its highest-priority sheet.
const UNCATEGORISED = 'Uncategorised';
const groups = new Map<string, typeof cheatsheets>();

for (const entry of cheatsheets) {
  const key = entry.data.category ?? UNCATEGORISED;
  const group = groups.get(key);
  if (group) group.push(entry);
  else groups.set(key, [entry]);
}
---

<BaseLayout
  title="Cheat sheets"
  description="Dense reference material — commands, syntax and tables I keep forgetting."
>
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">Cheat sheets</h1>
    <p class="mt-3 text-lg text-neutral-600">
      Dense reference material, updated whenever I trip over something again.
    </p>
  </header>

  {
    cheatsheets.length === 0 ? (
      <p class="text-neutral-600">Nothing here yet.</p>
    ) : (
      <div class="space-y-10">
        {[...groups].map(([category, entries]) => (
          <section>
            <h2 class="border-b border-neutral-300 pb-1 font-mono text-xs tracking-widest text-neutral-500 uppercase">
              {category}
            </h2>
            {entries.map((entry) => (
              <PostCard
                href={`/cheatsheets/${entry.id}`}
                title={entry.data.title}
                description={entry.data.description}
                dateLabel="Updated "
                date={entry.data.updated}
                pinned={entry.data.pinned}
                draft={entry.data.draft}
              />
            ))}
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
