---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import {
  getResourceCheatsheets,
  getUltimateCheatsheet,
  groupResourceCheatsheets,
  resourceSheetPath,
  withBase,
} from '../../lib/collections';

const ultimate = await getUltimateCheatsheet();
const rendered = ultimate ? await render(ultimate) : null;
const groups = groupResourceCheatsheets(await getResourceCheatsheets());
---

<BaseLayout
  title={ultimate?.data.title ?? 'Ultimate Cheatsheet'}
  description={
    ultimate?.data.description ??
    'One living cheat sheet, updated from every source and hyperlinked to the detailed resource notes.'
  }
  indexable={!ultimate?.data.draft}
>
  <article data-pagefind-body={ultimate && !ultimate.data.draft ? true : undefined}>
    <header class="mb-10 max-w-[var(--content-width)]">
      <p
        class="font-mono text-xs tracking-wide text-faint uppercase"
        data-pagefind-filter="Collection"
        data-pagefind-meta="collection"
      >
        Ultimate Cheatsheet
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink" data-pagefind-meta="title">
        {ultimate?.data.title ?? 'Ultimate Cheatsheet'}
      </h1>
      <p class="mt-3 text-lg text-muted">
        {
          ultimate?.data.description ??
          'One sheet that keeps growing. Deep dives live under Resource Cheatsheets; this page links out to them.'
        }
      </p>
    </header>

    {
      rendered && (
        <div
          class="prose prose-neutral max-w-[var(--content-width)] prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-accent prose-code:font-mono prose-code:text-[0.9em] dark:prose-invert"
        >
          <rendered.Content />
        </div>
      )
    }

    <section class="mt-14 max-w-[var(--content-width)]" data-pagefind-ignore>
      <h2 class="text-xl font-semibold tracking-tight text-ink">All resource sheets</h2>
      <p class="mt-2 text-muted">
        Every broken-down module, grouped by source. This list updates when a new resource sheet is
        added.
      </p>
      <div class="mt-6 space-y-8">
        {
          groups.map((group) => (
            <div>
              <h3 class="font-mono text-xs tracking-widest text-faint uppercase">
                <a href={withBase(`/resources/${group.slug}`)} class="no-underline hover:underline">
                  {group.resource}
                </a>
              </h3>
              <ul class="mt-2 space-y-1">
                {group.entries.map((entry) => (
                  <li>
                    <a href={withBase(resourceSheetPath(entry, group))}>
                      {entry.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import '../../scripts/copy-code';
</script>
