---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/collections';

const sections = [
  {
    href: withBase('/cheatsheets'),
    title: 'Ultimate Cheatsheet',
    description: 'One living sheet, added to as I go, hyperlinked into the detailed resource notes.',
  },
  {
    href: withBase('/resources'),
    title: 'Resource Cheatsheets',
    description: 'Each book or course has its own tab; each tab is modules and chapters, broken down.',
  },
  {
    href: withBase('/explainers'),
    title: 'Explainers',
    description: 'Long-form pieces on how something actually works.',
  },
  {
    href: withBase('/notes'),
    title: 'Notes',
    description: 'Short thoughts and opinions, written down before they evaporate.',
  },
  {
    href: withBase('/example-projects'),
    title: 'Example Projects',
    description: 'Book example projects — the code only.',
  },
  {
    href: withBase('/full-picture'),
    title: 'Full Picture Projects',
    description: 'The same exercises with screenshots of what happened, linked back to the code.',
  },
];
---

<BaseLayout
  title="Cyber Journey"
  description="Ultimate and resource cheat sheets, example projects, and full-picture walkthroughs — a personal reference pile."
>
  <p class="max-w-[var(--content-width)] text-lg text-muted">
    A personal reference pile: things I looked up twice, things I had to explain to understand, and
    thoughts I did not want to lose.
  </p>

  <ul class="mt-10 space-y-5">
    {
      sections.map((section) => (
        <li class="border-b border-line pb-5 last:border-b-0">
          <h2 class="text-lg font-medium tracking-tight">
            <a href={section.href} class="no-underline hover:underline">
              {section.title}
            </a>
          </h2>
          <p class="mt-1 text-muted">{section.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
