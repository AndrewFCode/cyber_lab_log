---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/collections';

const links = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/cheatsheets'), label: 'Cheat sheets' },
  { href: withBase('/explainers'), label: 'Explainers' },
  { href: withBase('/notes'), label: 'Notes' },
  { href: withBase('/projects'), label: 'Projects' },
  { href: withBase('/search'), label: 'Search' },
];
---

<BaseLayout
  title="Page not found"
  description="That URL is not a page on this site."
>
  <header class="mb-8 max-w-[var(--content-width)]">
    <p class="font-mono text-xs tracking-wide text-faint uppercase">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink">Page not found</h1>
    <p class="mt-3 text-lg text-muted">
      Nothing is published at this address. Try the sections below, or search.
    </p>
  </header>

  <nav aria-label="Helpful links">
    <ul class="space-y-3">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-lg no-underline hover:underline">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</BaseLayout>
