---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getExplainers, neighbors, readingTime, withBase } from '../../lib/collections';

export const getStaticPaths = (async () => {
  const explainers = await getExplainers();
  return explainers.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      ...neighbors(explainers, entry.id, (item) => `/explainers/${item.id}`),
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  label="Explainer"
  collection="explainers"
  backHref={withBase('/explainers')}
  backLabel="Explainers"
  pubDate={entry.data.pubDate}
  updated={entry.data.updated}
  draft={entry.data.draft}
  tags={entry.data.tags}
  readingTime={readingTime(entry.body)}
  headings={headings}
  prev={prev}
  next={next}
  meta={entry.data.difficulty ? [entry.data.difficulty] : []}
>
  <Content />
</ContentLayout>
