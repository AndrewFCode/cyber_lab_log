---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getLabs, LAB_SERIES_LABELS, withBase } from '../../lib/collections';

const labs = await getLabs();
const seriesOrder = ['powershell', 'linux'] as const;
const groups = seriesOrder
  .map((series) => ({
    series,
    label: LAB_SERIES_LABELS[series],
    entries: labs.filter((entry) => entry.data.series === series),
  }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title="Full Picture Projects"
  description="Walkthroughs with screenshots of results, each linked back to the matching example project (code only)."
>
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Full Picture Projects</h1>
    <p class="mt-3 text-lg text-muted">
      The same exercises as <a href={withBase('/example-projects')}>Example Projects</a>, plus
      screenshots of what the commands actually did.
    </p>
  </header>

  {
    labs.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <div class="space-y-10">
        {groups.map((group) => (
          <section>
            <h2 class="border-b border-line pb-1 font-mono text-xs tracking-widest text-faint uppercase">
              {group.label}
            </h2>
            {group.entries.map((entry) => (
              <PostCard
                href={withBase(`/full-picture/${entry.id}`)}
                title={entry.data.title}
                description={entry.data.description}
                dateLabel=""
                date={entry.data.pubDate}
                draft={entry.data.draft}
                meta={entry.data.lab ? [entry.data.lab] : []}
              />
            ))}
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
