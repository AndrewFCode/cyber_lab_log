---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import ResourceTabs from '../../components/ResourceTabs.astro';
import PostCard from '../../components/PostCard.astro';
import {
  getResourceCheatsheets,
  groupResourceCheatsheets,
  neighbors,
  readingTime,
  resourceSheetPath,
  withBase,
  type CheatsheetEntry,
  type ResourceGroup,
} from '../../lib/collections';

export const getStaticPaths = (async () => {
  const groups = groupResourceCheatsheets(await getResourceCheatsheets());

  return groups.flatMap((group) => {
    const hrefFor = (item: CheatsheetEntry) => resourceSheetPath(item, group);

    const paths: {
      params: { slug: string };
      props: {
        group: ResourceGroup;
        groups: ResourceGroup[];
        entry?: CheatsheetEntry;
        unit?: number;
        unitEntries?: CheatsheetEntry[];
        prev?: { href: string; title: string };
        next?: { href: string; title: string };
      };
    }[] = [
      {
        params: { slug: group.slug },
        props: { group, groups },
      },
    ];

    const byUnit = new Map<number, CheatsheetEntry[]>();
    const noUnit: CheatsheetEntry[] = [];

    for (const entry of group.entries) {
      const unit = entry.data.unit;
      if (typeof unit === 'number') {
        const list = byUnit.get(unit) ?? [];
        list.push(entry);
        byUnit.set(unit, list);
      } else {
        noUnit.push(entry);
      }
    }

    for (const [unit, sheets] of byUnit) {
      if (sheets.length === 1) {
        const entry = sheets[0]!;
        paths.push({
          params: { slug: `${group.slug}/${unit}` },
          props: { group, groups, entry, unit, ...neighbors(group.entries, entry.id, hrefFor) },
        });
      } else {
        paths.push({
          params: { slug: `${group.slug}/${unit}` },
          props: { group, groups, unit, unitEntries: sheets },
        });
      }

      for (const entry of sheets) {
        paths.push({
          params: { slug: `${group.slug}/${unit}/${entry.id}` },
          props: { group, groups, entry, unit, ...neighbors(group.entries, entry.id, hrefFor) },
        });
      }
    }

    for (const entry of noUnit) {
      paths.push({
        params: { slug: `${group.slug}/${entry.id}` },
        props: { group, groups, entry, ...neighbors(group.entries, entry.id, hrefFor) },
      });
    }

    return paths;
  });
}) satisfies GetStaticPaths;

interface Props {
  group: ResourceGroup;
  groups: ResourceGroup[];
  entry?: CheatsheetEntry;
  unit?: number;
  unitEntries?: CheatsheetEntry[];
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { group, groups, entry, unit, unitEntries, prev, next } = Astro.props;

const resourceTabs = groups.map((item) => ({
  href: withBase(`/resources/${item.slug}`),
  label: item.resource,
  current: item.slug === group.slug,
}));

const moduleTabs = group.entries.map((item) => ({
  href: withBase(resourceSheetPath(item, group)),
  label: item.data.module ?? item.data.title,
  current: entry?.id === item.id,
}));

const rendered = entry ? await render(entry) : null;
const listed = unitEntries ?? (entry ? undefined : group.entries);
const listTitle = unitEntries ? `${group.resource} · ${unit}` : group.resource;
---

{
  entry && rendered ? (
    <ContentLayout
      title={entry.data.title}
      description={entry.data.description}
      label="Resource Cheatsheet"
      collection="cheatsheets"
      backHref={withBase(`/resources/${group.slug}`)}
      backLabel={group.resource}
      updated={entry.data.updated}
      draft={entry.data.draft}
      tags={entry.data.tags}
      readingTime={readingTime(entry.body)}
      headings={rendered.headings}
      prev={prev}
      next={next}
      meta={[group.resource, entry.data.module].filter((item): item is string => Boolean(item))}
      slug={entry.id}
    >
      <ResourceTabs slot="chrome" resources={resourceTabs} modules={moduleTabs} />
      <rendered.Content />
    </ContentLayout>
  ) : (
    <BaseLayout
      title={listTitle}
      description={`Modules and chapters from ${group.resource}.`}
    >
      <header class="mb-8 max-w-[var(--content-width)]">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm">
          <a href={withBase('/resources')} class="no-underline hover:underline">
            &larr; Resource Cheatsheets
          </a>
        </nav>
        <h1 class="text-3xl font-semibold tracking-tight text-ink">{listTitle}</h1>
        <p class="mt-3 text-lg text-muted">
          {
            unitEntries
              ? 'Sheets in this section. Open one for the full notes.'
              : 'Each tab is a module or chapter — the broken-down cheat sheet for this resource.'
          }
        </p>
      </header>

      <div class="mb-8">
        <ResourceTabs resources={resourceTabs} modules={moduleTabs} />
      </div>

      {listed?.map((item) => (
        <PostCard
          href={withBase(resourceSheetPath(item, group))}
          title={item.data.title}
          description={item.data.description}
          dateLabel="Updated "
          date={item.data.updated}
          pinned={item.data.pinned}
          draft={item.data.draft}
          meta={item.data.module ? [item.data.module] : []}
        />
      ))}
    </BaseLayout>
  )
}
