---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesBrowser from '../../components/NotesBrowser.astro';
import { getNotes } from '../../lib/collections';

const notes = await getNotes();
---

<BaseLayout title="Lesson Notes" description="Class notes from courses and books, plus shorter thoughts.">
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Lesson Notes</h1>
    <p class="mt-3 text-lg text-muted">
      Class notes from courses and books, plus shorter thoughts.
    </p>
  </header>

  {
    notes.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <NotesBrowser notes={notes} />
    )
  }
</BaseLayout>
