---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getNotes, withBase } from '../../lib/collections';

const notes = await getNotes();
---

<BaseLayout title="Lesson Notes" description="Class notes from courses and books, plus shorter thoughts.">
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Lesson Notes</h1>
    <p class="mt-3 text-lg text-muted">
      Class notes from courses and books, plus shorter thoughts. Newest first.
    </p>
  </header>

  {
    notes.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <div>
        {notes.map((entry) => (
          <PostCard
            href={withBase(`/notes/${entry.id}`)}
            title={entry.data.title}
            description={entry.data.description}
            dateLabel=""
            date={entry.data.pubDate}
            draft={entry.data.draft}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
