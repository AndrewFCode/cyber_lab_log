---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getProjects, withBase } from '../../lib/collections';

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="What I am building, why it exists, and the prompt when an agent wrote the first draft."
>
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Projects</h1>
    <p class="mt-3 text-lg text-muted">
      Details of each project and the reason it exists. If it started as an AI generation, the
      initial command is on the page.
    </p>
  </header>

  {
    projects.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <div>
        {projects.map((entry) => (
          <PostCard
            href={withBase(`/projects/${entry.id}`)}
            title={entry.data.title}
            description={entry.data.description ?? entry.data.why}
            dateLabel=""
            date={entry.data.pubDate}
            draft={entry.data.draft}
            meta={[
              { active: 'Active', paused: 'Paused', shipped: 'Shipped', archived: 'Archived' }[
                entry.data.status
              ],
              entry.data.origin === 'ai' ? 'AI-generated' : 'Handwritten',
            ]}
          />
        ))}
      </div>
    )
  }
</BaseLayout>
