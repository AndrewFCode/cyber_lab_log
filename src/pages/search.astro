---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
---

<BaseLayout
  title="Search"
  description="Search published cheat sheets, explainers, notes and projects."
>
  <header class="mb-8 max-w-[var(--content-width)]">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">Search</h1>
    <p class="mt-3 text-lg text-muted">
      Full-text search across published cheat sheets, explainers, notes and projects. Drafts are not indexed.
    </p>
    <p class="mt-2 font-mono text-xs text-faint">Press Ctrl+K or ⌘K from any page</p>
  </header>

  <Search autofocus />
</BaseLayout>
