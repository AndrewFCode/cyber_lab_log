---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/cheatsheets', label: 'Cheat sheets' },
  { href: '/explainers', label: 'Explainers' },
  { href: '/notes', label: 'Notes' },
  { href: '/tags', label: 'Tags' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-4">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight text-ink no-underline">
      knowledge&nbsp;blog
    </a>
    <nav aria-label="Sections" class="flex gap-5 text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'no-underline',
              isActive(link.href)
                ? 'font-medium text-ink underline decoration-accent decoration-2 underline-offset-4'
                : 'text-muted hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
