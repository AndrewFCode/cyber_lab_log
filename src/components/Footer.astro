---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line" data-pagefind-ignore="all">
  <div
    class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2 px-5 py-6 text-sm text-faint"
  >
    <p>&copy; {year}</p>
    <p class="font-mono text-xs">Built with Astro</p>
  </div>
</footer>
