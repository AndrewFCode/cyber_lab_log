---
import { tagSlug, withBase } from '../lib/collections';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <a
            href={withBase(`/tags/${tagSlug(tag)}`)}
            class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted no-underline hover:border-accent hover:text-accent"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
