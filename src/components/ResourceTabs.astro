---
interface Tab {
  href: string;
  label: string;
  current: boolean;
}

interface Props {
  resources: Tab[];
  modules?: Tab[];
}

const { resources, modules = [] } = Astro.props;
---

<div class="space-y-3">
  <div role="tablist" aria-label="Resources" class="flex flex-wrap gap-2">
    {
      resources.map((tab) => (
        <a
          href={tab.href}
          role="tab"
          aria-selected={tab.current}
          class:list={[
            'rounded border px-3 py-1.5 font-mono text-xs tracking-wide no-underline',
            tab.current
              ? 'border-accent bg-chip font-medium text-ink'
              : 'border-line text-muted hover:border-accent hover:text-ink',
          ]}
        >
          {tab.label}
        </a>
      ))
    }
  </div>

  {
    modules.length > 0 && (
      <div role="tablist" aria-label="Modules and chapters" class="flex flex-wrap gap-2">
        {modules.map((tab) => (
          <a
            href={tab.href}
            role="tab"
            aria-selected={tab.current}
            class:list={[
              'rounded border px-3 py-1.5 text-sm no-underline',
              tab.current
                ? 'border-accent bg-chip font-medium text-ink'
                : 'border-line text-muted hover:border-accent hover:text-ink',
            ]}
          >
            {tab.label}
          </a>
        ))}
      </div>
    )
  }
</div>
