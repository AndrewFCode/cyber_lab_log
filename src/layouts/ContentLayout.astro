---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/collections';

interface Props {
  title: string;
  description?: string;
  /** Section label, e.g. "Cheat sheet". */
  label: string;
  /** Link back to the section index. */
  backHref: string;
  backLabel: string;
  /** First published; absent on cheat sheets, which only track `updated`. */
  pubDate?: Date;
  updated?: Date;
  draft?: boolean;
  /** Small pieces of metadata shown next to the dates, e.g. difficulty. */
  meta?: string[];
}

const { title, description, label, backHref, backLabel, pubDate, updated, draft, meta = [] } =
  Astro.props;

// Only worth showing an "Updated" line when it differs from the publish date.
const showUpdated =
  updated && (!pubDate || updated.valueOf() !== pubDate.valueOf());
---

<BaseLayout title={title} description={description}>
  <article class="prose-wrapper">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm">
      <a href={backHref} class="no-underline hover:underline">&larr; {backLabel}</a>
    </nav>

    <header class="mb-10 max-w-[var(--content-width)]">
      <p class="font-mono text-xs tracking-wide text-neutral-500 uppercase">{label}</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-neutral-900">
        {title}
        {
          draft && (
            <span class="ml-2 align-middle rounded border border-amber-300 bg-amber-50 px-1.5 py-0.5 font-mono text-xs font-normal tracking-wide text-amber-700 uppercase">
              Draft
            </span>
          )
        }
      </h1>
      {description && <p class="mt-3 text-lg text-neutral-600">{description}</p>}

      <dl class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm text-neutral-500">
        {
          pubDate && (
            <div class="flex gap-1.5">
              <dt class="sr-only">Published</dt>
              <dd>
                <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
              </dd>
            </div>
          )
        }
        {
          showUpdated && (
            <div class="flex gap-1.5">
              <dt>Updated</dt>
              <dd>
                <time datetime={updated!.toISOString()}>{formatDate(updated!)}</time>
              </dd>
            </div>
          )
        }
        {
          meta.map((item) => (
            <div>
              <dt class="sr-only">Detail</dt>
              <dd>{item}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="prose prose-neutral max-w-[var(--content-width)] prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-[var(--color-accent)] prose-code:font-mono prose-code:text-[0.9em]">
      <slot />
    </div>
  </article>
</BaseLayout>
