---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Widen the main column so a desktop table of contents can sit beside prose. */
  wide?: boolean;
  /** When true, Pagefind indexes this page's `data-pagefind-body` region. */
  indexable?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description, wide = false, indexable = false, ogImage, ogType, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
  </head>
  <body
    class="min-h-screen bg-page text-ink"
    data-pagefind-ignore={indexable ? undefined : 'all'}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-page focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['mx-auto px-5 py-10', wide ? 'max-w-6xl' : 'max-w-4xl']}>
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
